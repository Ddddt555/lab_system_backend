# ============================================================
# 必填项：复制本文件为 .env，并填入你自己的真实密码
# ============================================================

# MySQL 数据库 root 密码
MYSQL_ROOT_PASSWORD=your_db_password_here

# Redis 缓存密码（必填，Redis 会以该密码启动）
REDIS_PASSWORD=your_redis_password_here

# MinIO 对象存储凭据（启动后可用此账号登录 http://localhost:9001）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password

# JWT 签名密钥（必须至少 32 个字符，否则后端会启动失败）
JWT_SECRET=your_jwt_secret_must_be_at_least_32_chars_long

# Grafana 管理员密码（生产环境必填）
GRAFANA_PASSWORD=your_grafana_password_here

# ============================================================
# 可选配置（通常保持默认即可）
# ============================================================

# 允许跨域的前端地址（本地开发默认是 Vite 的 5173 端口）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 管理员首次启动时的初始密码（若不配置，系统将随机生成并打印在后端容器日志中）
# ADMIN_INIT_PASSWORD=your_admin_initial_password

# 镜像版本标签（生产环境建议固定版本，如 v1.0.0）
# IMAGE_TAG=latest

# 是否开启 cpolar 内网穿透兼容模式（true/false）
# CPOLAR_COMPATIBLE=false

# 应用专用数据库账号（只有在使用 docker-compose.prod.yml 部署时才需要填）
# DB_USERNAME=lab_app
# DB_APP_PASSWORD=your_app_db_password_here

# 运行环境（dev / prod）
# SPRING_PROFILES_ACTIVE=dev